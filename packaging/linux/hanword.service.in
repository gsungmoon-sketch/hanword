# hanword systemd unit (generated by install.sh from hanword.service.in).
# Local changes: `sudo systemctl edit hanword` (drop-in), not this file - install.sh overwrites it.
# Local mode has no login, so the server only listens on 127.0.0.1 (this machine).
[Unit]
Description=hanword web word processor (local mode)
After=network.target

[Service]
Type=simple
User=@USER@
Group=@USER@
Environment=HOME=@DATA@
Environment=LANG=C.UTF-8
Environment=PYTHONIOENCODING=utf-8
WorkingDirectory=@DATA@
ExecStart=@PREFIX@/hanword serve --host 127.0.0.1 --port @PORT@ --data @DATA@/documents
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077

# Hardening (the one-file binary unpacks itself to the private /tmp at start)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA@
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
