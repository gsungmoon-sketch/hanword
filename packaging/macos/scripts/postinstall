#!/bin/sh
# hanword postinstall: hidden service user, data/log dirs, symlink, start the LaunchDaemon,
# then open the editor for the logged-in user (not for command-line installs).
set -u
LABEL=com.hanword.server
PLIST=/Library/LaunchDaemons/$LABEL.plist
LIB=/usr/local/hanword
DATA="/Library/Application Support/hanword"
LOGS=/Library/Logs/hanword
U=_hanword
USERS_DIR=/Users      # directory-service nodes (dscl)
GROUPS_DIR=/Groups
PORT=8088

# 1. hidden system user/group (UID/GID in the 400-499 range, first free one)
free_id() { # $1 = /Users | /Groups, $2 = UniqueID | PrimaryGroupID
    used=$(dscl . -list "$1" "$2" | awk '{print $2}')
    i=400
    while [ $i -lt 500 ]; do
        echo "$used" | grep -qx "$i" || { echo $i; return 0; }
        i=$((i + 1))
    done
    return 1
}
if ! dscl . -read "$GROUPS_DIR/$U" >/dev/null 2>&1; then
    GID=$(free_id /Groups PrimaryGroupID) || { echo "no free GID" >&2; exit 1; }
    dscl . -create "$GROUPS_DIR/$U"
    dscl . -create "$GROUPS_DIR/$U" PrimaryGroupID "$GID"
    dscl . -create "$GROUPS_DIR/$U" RealName "hanword server"
    dscl . -create "$GROUPS_DIR/$U" Password '*'
fi
GID=$(dscl . -read "$GROUPS_DIR/$U" PrimaryGroupID | awk '{print $2}')
if ! dscl . -read "$USERS_DIR/$U" >/dev/null 2>&1; then
    UID_=$(free_id /Users UniqueID) || { echo "no free UID" >&2; exit 1; }
    dscl . -create "$USERS_DIR/$U"
    dscl . -create "$USERS_DIR/$U" UniqueID "$UID_"
    dscl . -create "$USERS_DIR/$U" PrimaryGroupID "$GID"
    dscl . -create "$USERS_DIR/$U" UserShell /usr/bin/false
    dscl . -create "$USERS_DIR/$U" NFSHomeDirectory /var/empty
    dscl . -create "$USERS_DIR/$U" RealName "hanword server"
    dscl . -create "$USERS_DIR/$U" Password '*'
    dscl . -create "$USERS_DIR/$U" IsHidden 1
fi

# 2. directories: data 0700 and logs 0750, owned by the service user
mkdir -p "$DATA/documents" "$LOGS"
chown "$U:$U" "$DATA" "$DATA/documents" "$LOGS"
chmod 0700 "$DATA" "$DATA/documents"
chmod 0750 "$LOGS"

# 3. program permissions + command-line symlink
chown -R root:wheel "$LIB"
chmod -R go-w "$LIB"
mkdir -p /usr/local/bin
ln -sfn "$LIB/hanword" /usr/local/bin/hanword
chown root:wheel "$PLIST"
chmod 0644 "$PLIST"

# 4. start the daemon
launchctl bootout "system/$LABEL" >/dev/null 2>&1 || true
launchctl bootstrap system "$PLIST" || launchctl load -w "$PLIST"
launchctl enable "system/$LABEL" >/dev/null 2>&1 || true

# 5. open the editor for the console user (GUI installs only)
if [ -z "${COMMAND_LINE_INSTALL:-}" ]; then
    CU=$(stat -f %Su /dev/console 2>/dev/null || echo root)
    if [ -n "$CU" ] && [ "$CU" != root ] && [ "$CU" != loginwindow ]; then
        i=0
        while [ $i -lt 40 ] && ! curl -fsS -o /dev/null "http://127.0.0.1:$PORT/healthz" 2>/dev/null; do
            sleep 0.5; i=$((i + 1))
        done
        launchctl asuser "$(id -u "$CU")" sudo -u "$CU" open "http://127.0.0.1:$PORT/" >/dev/null 2>&1 || true
    fi
fi
exit 0
